{
  "manifest_version": 3,
  "name": "annotaKit",
  "version": "0.1.0",
  "description": "Click your UI, leave notes, and generate agent-ready context.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-annotakit": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle annotaKit on current page"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "annotakit@nodestarq",
      "strict_min_version": "109.0"
    }
  }
}
